    "@angular/platform-browser-dynamic": "19.2.21",
    "@angular/router": "19.2.21",
    "ng-zorro-antd": "19.3.1",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.15.1"
  },
  "overrides": {
